# Parsed by Cloudflare Workers Static Assets. Worker-generated /api responses
# must continue to attach their own security and CORS headers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://open.er-api.com https://api.frankfurter.app https://accounts.google.com https://accounts.google.com/gsi/; frame-src https://accounts.google.com https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-DNS-Prefetch-Control: off

/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/auth.html
  Cache-Control: private, no-store

/auth
  Cache-Control: private, no-store

/account.html
  Cache-Control: private, no-store

/account
  Cache-Control: private, no-store

/admin.html
  Cache-Control: private, no-store

/admin
  Cache-Control: private, no-store

/site-config.js
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=3600, must-revalidate

/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow
